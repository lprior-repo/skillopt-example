{
  "name": "react-typescript",
  "description": "TypeScript strict mode + React hooks lint rules",
  "forbidden_tokens": {
    "any": "forbidden:any",
    "unknown": "forbidden:unknown",
    "console.log": "forbidden:console",
    "@ts-ignore": "forbidden:ts_ignore",
    "@ts-nocheck": "forbidden:ts_nocheck",
    "as unknown as": "forbidden:as_unknown_as"
  },
  "grade_issue_keys": [
    "json_errors",
    "mutation_errors",
    "protected_changed",
    "execution_errors",
    "forbidden_matches",
    "missing_groups"
  ],
  "grade_returncode_keys": [
    "tsc_returncode",
    "eslint_returncode",
    "vitest_returncode"
  ],
  "success_threshold_hard": 1.0,
  "max_examples": 5
}